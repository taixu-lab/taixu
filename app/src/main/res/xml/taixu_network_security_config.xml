<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        网络层允许明文：Network Security Config 不能按 CIDR 放行 192.168.0.0/16，
        明文目标由业务端点策略收口（MCP 仅 localhost、回环与 192.168.*，公网仍强制 HTTPS）。
        localhost、127.0.0.1、::1、10.0.2.2 已包含在下面的 base-config 里。

        不要再加 domain-config。Shizuku 13.6 会在已经装过默认网络安全配置的进程里
        实例化 Application。默认明文策略与本配置不一致，且任一侧带有 per-domain 规则时，
        NetworkSecurityConfigProvider.handleNewApplication 抛出
        Found multiple conflicting per-domain rules，UserService 进程直接退出。
        只保留没有 domain 的 base-config，框架才会改用较宽松的那份明文策略。
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
